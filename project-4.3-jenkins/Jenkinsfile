// Project 4.3 — Jenkins pipeline that provisions infrastructure with Terraform.
// Stages: checkout -> init -> plan -> manual approval -> apply (Task 4).
pipeline {
  agent any

  environment {
    // GCP auth: a Jenkins "Secret file" credential holding the service-account
    // JSON key. Bound to a file path Terraform's google provider reads.
    GOOGLE_APPLICATION_CREDENTIALS = credentials('gcp-sa-key')
    // Passed to Terraform as var.project_id (edit to your project).
    TF_VAR_project_id = 'capstone-project-505907'
    TF_IN_AUTOMATION  = 'true'
  }

  options {
    timestamps()
  }

  stages {
    stage('Checkout') {                       // Task 4: source code checkout
      steps { checkout scm }
    }

    stage('Terraform Init') {                 // Task 4: terraform initialisation
      steps {
        dir('project-4.3-jenkins/terraform') {
          sh 'terraform init -input=false'
        }
      }
    }

    stage('Terraform Plan') {                 // Task 4: terraform plan generation
      steps {
        dir('project-4.3-jenkins/terraform') {
          sh 'terraform plan -input=false -out=tfplan'
        }
      }
    }

    stage('Approval') {                       // Elevate: manual approval gate
      steps {
        input message: 'Apply these infrastructure changes?', ok: 'Apply'
      }
    }

    stage('Terraform Apply') {                // Task 4/5: infrastructure deployment
      steps {
        dir('project-4.3-jenkins/terraform') {
          sh 'terraform apply -input=false tfplan'
        }
      }
    }
  }

  post {
    success { echo 'Infrastructure provisioned successfully.' }
    failure { echo 'Pipeline failed — check the Terraform logs above.' }
  }
}
